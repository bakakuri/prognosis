# ============================================================
# PredictX — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control
# ============================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5000

# ============================================================
# Database — Supabase PostgreSQL
# ============================================================
DATABASE_URL=postgresql://postgres:Bajbajuna123!@db.sucfxbilwjhpuuarhbcu.supabase.co:5432/postgres
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=10000

# ============================================================
# Football Data Provider — API-Football
# https://www.api-football.com — Free: 100 requests/day
# Paid plans available for higher limits
# ============================================================
FOOTBALL_API_KEY=your_api_football_key_here
FOOTBALL_API_HOST=v3.football.api-sports.io
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io

# ============================================================
# Odds Provider (optional — set if available)
# ============================================================
# ODDS_API_KEY=
# ODDS_API_URL=

# ============================================================
# Cache
# ============================================================
CACHE_TTL_SHORT=60          # 1 minute — live match data
CACHE_TTL_MEDIUM=300        # 5 minutes — fixtures, standings
CACHE_TTL_LONG=3600         # 1 hour — team/league data
CACHE_TTL_VERY_LONG=86400   # 24 hours — static data

# ============================================================
# Sync Job Schedule (cron expressions)
# ============================================================
SYNC_LIVE=*/1 * * * *           # Every minute during matches
SYNC_FIXTURES=0 */6 * * *       # Every 6 hours
SYNC_RESULTS=*/15 * * * *       # Every 15 minutes
SYNC_STANDINGS=0 */2 * * *      # Every 2 hours
SYNC_TEAMS=0 0 * * 0            # Weekly (Sunday midnight)
SYNC_PLAYERS=0 1 * * 0          # Weekly (Sunday 1am)
SYNC_INJURIES=0 */4 * * *       # Every 4 hours
SYNC_LINEUPS=0 */1 * * *        # Every hour near match time
SYNC_STATISTICS=*/30 * * * *    # Every 30 minutes
SYNC_PREDICTIONS=*/5 * * * *    # Every 5 minutes

# ============================================================
# Prediction Engine
# ============================================================
MODEL_VERSION=predictx-1.0.0
ELO_K_FACTOR=32
ELO_HOME_ADVANTAGE=100
FORM_MATCH_WINDOW=10
FORM_DECAY_FACTOR=0.85
MIN_MATCHES_FOR_PREDICTION=5
ENSEMBLE_ELO_WEIGHT=0.20
ENSEMBLE_POISSON_WEIGHT=0.25
ENSEMBLE_DC_WEIGHT=0.20
ENSEMBLE_FORM_WEIGHT=0.20
ENSEMBLE_XG_WEIGHT=0.15

# ============================================================
# Security
# ============================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info
LOG_FILE=logs/predictx.log
